pipeline {
    agent any
    environment {
        SONARQUBE_URL = 'http://192.168.100.221:9000'
        SONARQUBE_TOKEN = 'sqa_2087aa03631e1a3f065e98c85f3a9d74758958fb'
    }
    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('GIT') {
            steps {
                git branch: 'gestion_instructor', url: 'https://github.com/Mahmoud-Amri/Devops_Gestion-Sky.git'
            }
        }

        stage('Compile Stage') {
            steps {
                sh 'mvn clean package'  // Génère le JAR dans target/
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -la target/'  // Affiche le contenu du dossier target pour vérifier le nom du fichier JAR
            }
        }


        stage('Verify JAR') {
            steps {
                // Vérifie l'existence du fichier JAR généré
                sh 'ls -la target/'
                sh 'find . -name "*.jar"'  // Liste tous les fichiers JAR pour debug
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    sh """
                    mvn sonar:sonar \
                        -Dsonar.projectKey="Jenkins_Integration" \
                        -Dsonar.host.url=${SONARQUBE_URL} \
                        -Dsonar.token=${SONARQUBE_TOKEN}
                    """
                }
            }
        }

        stage('Test Stage') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Maven Deploy') {
            steps {
                sh 'mvn deploy'
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh '''
                            echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    // Suppression de --platform linux/arm64 pour plus de compatibilité
                    sh 'docker build -t my-image:${BUILD_ID} .'
                    sh 'docker push my-image:${BUILD_ID}'
                }
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'  // Enregistre les résultats de test
        }
    }
}
