pipeline {
    agent any
    environment {
        // Variables d'environnement pour SonarQube
        SONARQUBE_URL = 'http://192.168.100.221:9000'
        SONARQUBE_TOKEN = 'sqa_2087aa03631e1a3f065e98c85f3a9d74758958fb'
    }
    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('GIT') {
            steps {
                // Cloner le dépôt Git
                git branch: 'gestion_instructor', url: 'https://github.com/Mahmoud-Amri/Devops_Gestion-Sky.git'
            }
        }

        stage('Compile Stage') {
            steps {
                // Compiler le projet
                sh 'mvn clean compile'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    // Analyse SonarQube avec le jeton
                    sh """
                    mvn sonar:sonar \
                        -Dsonar.projectKey="Jenkins_Integration" \
                        -Dsonar.host.url=${SONARQUBE_URL} \
                        -Dsonar.token=${SONARQUBE_TOKEN}
                    """
                }
            }
        }

        stage('Test Stage') {
            steps {
                // Exécuter les tests unitaires
                sh 'mvn test'
            }
        }

        stage('Maven Deploy') {
            steps {
                // Déployer le projet avec Maven
                sh 'mvn deploy'
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    // Utiliser les credentials Jenkins pour se connecter à Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh '''
                            echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    // Build Docker image
                    sh 'docker build -t my-image:${BUILD_ID} .'

                    // Push Docker image
                    sh 'docker push my-image:${BUILD_ID}'
                }
            }
        }
    }

    post {
        always {
            // Gérer les rapports de test JUnit après le pipeline
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
