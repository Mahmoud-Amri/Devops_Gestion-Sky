pipeline {
    agent any
   environment {
        // SonarQube environment variables
        SONARQUBE_URL = 'http://192.168.50.4:9000'
        SONARQUBE_TOKEN = 'sqa_2087aa03631e1a3f065e98c85f3a9d74758958fb'
    }
    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('GIT') {
            steps {
                // Cloner le dépôt Git
                git branch: 'gestion_instructor', url: 'https://github.com/Mahmoud-Amri/Devops_Gestion-Sky.git'
            }
        }

        stage('Compile Stage') {
            steps {
                // Compiler le projet
                sh 'mvn clean compile'
            }
        }
        stage('SonarQube Analysis') {
                    steps {
                        script {
                            // Run SonarQube analysis using the correct token property
                            sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=Jenkins Integration\
                                -Dsonar.host.url=${SONARQUBE_URL} \
                                -Dsonar.token=${SONARQUBE_TOKEN}
                            """
                        }
                    }
                }

        stage('Test Stage') {
            steps {
                // Exécuter les tests unitaires
                sh 'mvn test'
            }
            // Optionnel : vous pouvez ajouter un post-action pour gérer les résultats de test
            post {
                always {
                    junit '**/target/surefire-reports/*.xml' // Utilisez cette ligne si vous générez des rapports de test JUnit
                }
            }
        }
    }
}
