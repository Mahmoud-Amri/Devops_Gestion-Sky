pipeline {
    agent any
    environment {
        SONARQUBE_URL = 'http://192.168.100.221:9000'
        SONARQUBE_TOKEN = 'sqa_2087aa03631e1a3f065e98c85f3a9d74758958fb'
    }
    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'gestion_instructor', url: 'https://github.com/Mahmoud-Amri/Devops_Gestion-Sky.git'
            }
        }

        stage('Compile Project') {
            steps {
                sh 'mvn clean package' // Compile le projet et génère le fichier JAR dans le dossier target/
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -la target/'
                sh 'find . -name "*.jar"' // Liste tous les fichiers JAR pour le débogage
            }
        }

        stage('Rename JAR if necessary') {
            steps {
                script {
                    sh 'mv target/*.jar target/gestion-station-sky-1.0.jar'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    sh """
                        mvn sonar:sonar \
                        -Dsonar.projectKey="Jenkins_Integration" \
                        -Dsonar.host.url=${SONARQUBE_URL} \
                        -Dsonar.token=${SONARQUBE_TOKEN}
                    """
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy with Maven') {
            steps {
                sh 'mvn deploy'
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def dockerImage = "amrimahmoud/my-image:${BUILD_ID}"
                    sh "docker build -t ${dockerImage} ."
                    sh "docker push ${dockerImage}"
                }
            }
        }

        stage('Check and Install Docker Compose') {
            steps {
                script {
                    def dockerComposeInstalled = sh(script: 'which docker-compose || echo "not_installed"', returnStdout: true).trim()
                    if (dockerComposeInstalled == "not_installed") {
                        sh '''
                            curl -L "https://github.com/docker/compose/releases/download/1.29.2/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                            chmod +x /usr/local/bin/docker-compose
                        '''
                    }
                }
            }
        }

        stage('Start Docker Compose') {
            steps {
                script {
                    sh '/usr/local/bin/docker-compose -f docker-compose.yml up -d'
                    sleep 10
                }
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
