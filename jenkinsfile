pipeline {
    agent any
    environment {
        SONARQUBE_URL = 'http://192.168.100.221:9000'
        SONARQUBE_TOKEN = 'sqa_2087aa03631e1a3f065e98c85f3a9d74758958fb'
    }
    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'gestion_instructor', url: 'https://github.com/Mahmoud-Amri/Devops_Gestion-Sky.git'
            }
        }

        stage('Start Docker Compose') {
            steps {
                script {
                    // Démarre les services définis dans docker-compose.yml
                    sh 'docker-compose -f docker-compose.yml up -d'
                    // Attendre un peu pour que les services soient pleinement opérationnels
                    sleep 10
                }
            }
        }

        stage('Compile Project') {
            steps {
                sh 'mvn clean package'  // Compile le projet et génère le fichier JAR dans le dossier target/
            }
        }

        stage('Verify JAR') {
            steps {
                // Affiche le contenu du dossier target pour vérifier la génération du JAR
                sh 'ls -la target/'
                sh 'find . -name "*.jar"'  // Liste tous les fichiers JAR pour le débogage
            }
        }

        stage('Rename JAR if necessary') {
            steps {
                // Renomme le fichier JAR généré pour qu'il corresponde au nom attendu par le Dockerfile
                script {
                    sh 'mv target/*.jar target/gestion-station-sky-1.0.jar'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    sh """
                    mvn sonar:sonar \
                        -Dsonar.projectKey="Jenkins_Integration" \
                        -Dsonar.host.url=${SONARQUBE_URL} \
                        -Dsonar.token=${SONARQUBE_TOKEN}
                    """
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh 'mvn test'  // Exécute les tests Maven
            }
        }

        stage('Deploy with Maven') {
            steps {
                sh 'mvn deploy'  // Déploie le package Maven
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def dockerImage = "amrimahmoud/my-image:${BUILD_ID}"

                    sh "docker build -t ${dockerImage} ."
                    sh "docker push ${dockerImage}"
                }
            }
        }

        stage('Stop Docker Compose') {
            steps {
                script {
                    // Arrêter et supprimer les conteneurs Docker Compose après le test/deploiement
                    sh 'docker-compose -f docker-compose.yml down'
                }
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'  // Archive les résultats des tests JUnit pour l'analyse postérieure
        }
    }
}
